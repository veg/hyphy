ModelGeneticCode = {
		{14, 13, 14,  13,
		  7,  7,  7,   7, 
		 19,  5, 19,   5, 
		  2,  2, 	3,   2, 
		 12, 11, 12,  11,
		  6,  6,  6,   6, 
		 19, 19, 19,  19,
		  1,  1,  1,   1, 
		 16, 15, 16,  15,
		  8,  8,  8,   8, 
		 20, 20, 20,  20,
		  4,  4,  4,   4, 
		 10,  9, 10,   9, 
		  5,  5,  5,   5, 
		 10, 17, 18,  17,
		  1,  0,  1,   0 }
};

ModelGeneticCodeSize = 64;

for (h=0; h<64; h=h+1)
{
	if (ModelGeneticCode[h]==10)
	{
		ModelGeneticCodeSize=ModelGeneticCodeSize-1;
	}
}

TemplateNames = {{
	"One-step",
	"Two-step",
	"Three-step",
