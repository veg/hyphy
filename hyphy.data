if (nrChoice == 0)
{
	for (fileID = 1; fileID <= fileCount; fileID = fileID + 1)
	{
		ExecuteCommands ("Tree nucTree_" + fileID + "=" + treeStrings[fileID] + ";");
	}
	ExecuteCommands (constructLF("nucLF", "nucData", "nucTree", fileCount));
	Optimize (res,nucLF);
	stashLOF = LIKELIHOOD_FUNCTION_OUTPUT ;
