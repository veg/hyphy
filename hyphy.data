}
else
{
	step  = 0.1;
	step2 = 0.25;
	
	v1 = 0.05;
	for (v1c = 0; v1c < 10; v1c = v1c + 1)
	{
		v2 = v1+step; 
		for (v2c = 0; v2c < 20; v2c = v2c+1)
		{
