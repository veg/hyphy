								ModelMatrixName[h-hshift][v-vshift] := globalVariable_GT*synRate*EFV__[transition__][nucPosInCodon__];
								ModelMatrixName[v-vshift][h-hshift] := globalVariable_GT*synRate*EFV__[transition2__][nucPosInCodon__];
