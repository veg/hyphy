					if (branchLengths)
					{
						for (mpiNode = 0; mpiNode < totalBranchCount; mpiNode = mpiNode+1)
						{
							eCommand = "tr."+branchNames[mpiNode]+".t:="+Format(stashedLengths [mpiNode],20,12)+"/totalFactor";
							ExecuteCommands (eCommand);
