		{
			return 0;
		}
		if (distChoice == 2)
		{
			return _SITE_ON_COUNT[0]/_SITE_EN_COUNT[0];
		}
		if (distChoice == 3)
		{
			return -0.75*Log(1-4*(_SITE_ON_COUNT[0]/_SITE_EN_COUNT[0])/3);
		}
		if (distChoice == 4)
