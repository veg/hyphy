	fprintf (stdout,"BestTree =", bestTree);

	Tree				Inferred_Tree = bestTree;
	LikelihoodFunction  lf 			  = (filteredData, Inferred_Tree);

	Optimize (res,lf);
	fprintf (stdout, "\n",lf,"\n\n***********Save this tree to a file (y/n)?");

	fscanf  (stdin, "String", resp);


	if ((resp!="n")&&(resp!="N"))
	{
