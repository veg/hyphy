HarvestFrequencies (vectorOfFrequencies, filteredData,1,1,0);

MULTIPLY_BY_FREQS = PopulateModelMatrix ("HKY85",vectorOfFrequencies);

Model HKY85Model = (HKY85, vectorOfFrequencies, MULTIPLY_BY_FREQS);

