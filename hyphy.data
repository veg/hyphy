MULTIPLY_BY_FREQS = PopulateModelMatrix ("dayhoffModel",equalFreqs);
Model DayhoffModel = (dayhoffModel, equalFreqs, MULTIPLY_BY_FREQS);
FREQUENCY_SENSITIVE = 0;
