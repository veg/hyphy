}

LFCompute (lf,LF_DONE_COMPUTE);

fprintf (stdout, "\nExamined ", sampleCounter, " directions...\n");

if (bestDiff > 0)
{
	fprintf (stdout, "\nFound a likelihood improvement in the direction (", bestS, ",", bestNS, ")\n");
	slfo = LIKELIHOOD_FUNCTION_OUTPUT;
