     mss.sample_size += (^"`mss.namespace`.codon_data_info")[terms.data.sample_size];
   
     mpi.QueueJob (mss_selector.queue, "mss.handle_initial_fit", {"0" : mss_selector.path,
                                                     "1" : mss.namespace,
                                                     "2" : mss.genetic_code[terms.id],
                                                     "3" : TRUE},
                                                     "mss.store_initial_fit");
    
    
    
