    resp2 = 3; /* nr of nonsynonymous rate classes (in alternative model) (not used for PARRIS models except in output and postprocessing) */
	USE_LAST_RESULTS = 1;
}
else
{

/* Input nrs of rate classes: (presumably unused when they don't apply) */
