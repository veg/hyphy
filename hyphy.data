								{
									ModelMatrixName[h-hshift][v-vshift] := globalVariable_AT*synRate*EFV__[transition__][nucPosInCodon__];
									ModelMatrixName[v-vshift][h-hshift] := globalVariable_AT*synRate*EFV__[transition2__][nucPosInCodon__];
								}
								else
