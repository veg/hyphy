{
	sepString * "-";
}

for (k=0; k<maxModelWidth-6; k=k+1)
{
	capString * " ";
}

capString * "| Log Likelihood | #prms | AIC Score | c-AIC Score | Tree Length |\n";
sepString * "+----------------+-------+-----------+-------------+-------------+\n";
sepString * 0;
capString * 0;

branchLengthStash = 0;

