	}

	KeywordArgument ("rate-designation", "A 6 character model designation (e.g:010010 defines HKY85)", "010010");
	done = 0;
	while (!done)
	{
		modelDesc = io.PromptUserForString("Please enter a 6 character model designation (e.g:010010 defines HKY85)");
		if (Abs(modelDesc)==6)
		{	
			done = 1;
		}
	}	
}		
			
