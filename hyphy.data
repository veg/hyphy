									ModelMatrixName[h-hshift][v-vshift] := globalVariable_CT*synRate*EFV__[transition__][nucPosInCodon__];
									ModelMatrixName[v-vshift][h-hshift] := globalVariable_CT*synRate*EFV__[transition2__][nucPosInCodon__];
								}
