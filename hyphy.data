}

timer = Time(0);
fprintf (stdout, "\nSampling neutral directions\n");
if (timerCap > 0)
{
	while (Time(0)-timer <= timerCap)
	{
		v1 = Random(s_rateMin,s_rateMax);
		v2 = v1;
		
