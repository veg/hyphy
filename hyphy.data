function CreateTemplates (classID)
{
	MatrixTemplate = {240,1};
	matchCount = 0;

	if (classID < 2)
	{
		for (h=0; h<15; h=h+1)
		{
			for (v=h+1; v<16; v=v+1)
			{
				posCount = (h%4!=v%4)+(h$4!=v$4)-1;
								
				if (posCount == classID)
				{
					MatrixTemplate[matchCount] = h*16 + v;
					matchCount = matchCount+1;
					MatrixTemplate[matchCount] = v*16 + h;
					matchCount = matchCount+1;
				}
			}
		}
	}
	else
	{
		if (classID < 4)
		{
			for (h=0; h<15; h=h+1)
			{
				for (v=h+1; v<16; v=v+1)
				{
					diff = v-h;
					if ((h$4==v$4)||(h%4==v%4))
					{
						if (diff>=4)
						{
							diff = diff$4;
						}
					}
					else
					{
						continue;
					}
					
					if ((diff%2)==classID-2)
					{
						MatrixTemplate[matchCount] = h*16 + v;
						matchCount = matchCount+1;
						MatrixTemplate[matchCount] = v*16 + h;
						matchCount = matchCount+1;
					}
				}
			}
		}
	}
	return 0;
}

